# Copy this file to .env and fill the blanks. .env is not committed.
# Local `pnpm dev` reads .env. Production reads Cloudflare Worker secrets,
# plus CLOUDFLARE_D1_ID as a build environment variable.

# From `wrangler d1 create portfolio-blog`. Also set this in the Cloudflare build environment.
CLOUDFLARE_D1_ID=

# GitHub OAuth app. Callback: https://abdessattar.dev/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Any long random string. Used to sign the studio session cookie.
SESSION_SECRET=

# Fine-grained GitHub token for abdessattar23/portfolio-blog, Contents: Read and write.
GITHUB_CONTENT_TOKEN=

# Any long random string. IndexNow looks for it at https://abdessattar.dev/<this value>.txt
INDEXNOW_KEY=
